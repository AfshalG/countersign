# Names only. Copy to .env and fill in; .env is never committed.
# Each group is first needed by the slice in brackets.

# Chain (Slice 1). 10143 is testnet; 143 (mainnet) only after decision D5.
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=
MONAD_WS_URL=
USDC_ADDRESS=

# Deployer and relayers (Slices 1, 3, 6)
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEYS=

# Checker (Slice 10). Only the checker service reads these.
CHECKER_PRIVATE_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Attestation (Slice 2)
PRIMUS_APP_ID=
PRIMUS_APP_SECRET=

# Data (Slice 6)
DATABASE_URL=

# Spike 4: token door of the connector test server
CONNECTOR_TEST_TOKEN=
