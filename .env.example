# Names only. Copy to .env and fill in; .env is never committed.
# Each group is first needed by the slice in brackets.

# Chain (Slice 1). 10143 is testnet; 143 (mainnet) only after decision D5.
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=
MONAD_WS_URL=
USDC_ADDRESS=

# Deployer and relayers (Slices 1, 3, 6)
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEYS=

# Checker (Slice 10). Only the checker service reads these.
CHECKER_PRIVATE_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Attestation (Slice 2)
PRIMUS_APP_ID=
PRIMUS_APP_SECRET=

# Data (Slice 6)
DATABASE_URL=

# Spike 4: token door of the connector test server
CONNECTOR_TEST_TOKEN=

# Spike 3: testnet-only checker key for the payment-run spike
SPIKE3_CHECKER_PRIVATE_KEY=

# Slice 5 testnet run only: agent and checker keys, and a software passkey (P-256 private key)
SLICE5_AGENT_PRIVATE_KEY=
SLICE5_CHECKER_PRIVATE_KEY=
SLICE5_OWNER_P256_KEY=

# Gateway integration tests: a Postgres the tests may wipe (local Docker, or CI's service container)
TEST_DATABASE_URL=

# Gateway (Slice 6)
GATEWAY_SERVICE_TOKEN=
GATEWAY_DATABASE_URL=
TEST_CHECKER_PRIVATE_KEY=
# Gateway on Railway (Slice 6): its own service token, sent by the MCP server and the apps
GATEWAY_RAILWAY_SERVICE_TOKEN=
# The gateway's settings when run directly (scripts/testnet-run.ts sets these for its local run):
# DATABASE_URL, MONAD_CHAIN_ID, MONAD_WS_URL, RELAYER_PRIVATE_KEYS, GATEWAY_SERVICE_TOKEN,
# TEST_CHECKER_PRIVATE_KEY, PORT, and PUBLIC_URL (where status pages are opened; Slice 12)
